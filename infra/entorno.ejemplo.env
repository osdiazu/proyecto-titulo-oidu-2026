# Variables de entorno que lee infra/main.bicepparam (readEnvironmentVariable) y
# scripts/eliminar_entorno.sh (SUBSCRIPTION_ID_ESPERADA).
# Copiar como infra/entorno.local.env (ignorado por git) y completar SOLO en la copia local.
# No escribir valores en este archivo.
#
# Uso en Git Bash:
#   set -a; source infra/entorno.local.env; set +a
#
# Compilar parametros sin dejar los Object ID en el repositorio (hallazgo M-02):
#   TMP_BP=$(mktemp -d)
#   az bicep build-params --file infra/main.bicepparam --outfile "$TMP_BP/main.parameters.json"
#   rm -rf "$TMP_BP"
#
# Obtencion de los valores:
#   SQL_ADMIN_GROUP_OBJECT_ID : az ad group show -g grp-cobranza-sql-admin --query id -o tsv
#   OPERADOR_OBJECT_ID        : az ad signed-in-user show --query id -o tsv
#   IP_OPERADOR               : curl -s https://api.ipify.org   (vacio = SQL y Key Vault cerrados)
#   CICLO_KV                  : 1 en el primer despliegue; lo incrementa scripts/eliminar_entorno.sh
#                               (despues de eliminar, volver a cargar este archivo)
#   SUBSCRIPTION_ID_ESPERADA  : az account show --query id -o tsv (con la suscripcion del proyecto activa)

SQL_ADMIN_GROUP_OBJECT_ID=
OPERADOR_OBJECT_ID=
IP_OPERADOR=
CICLO_KV=1
SUBSCRIPTION_ID_ESPERADA=
