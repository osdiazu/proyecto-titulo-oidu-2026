<Project Sdk="Microsoft.NET.Sdk.Web">
  <!--
    Proyecto APT Cobranza Automatizada - API interna de consulta (Evidencia S11, ADR-001)
    Azure App Service Linux, runtime DOTNETCORE|10.0.
    Versiones de paquetes a confirmar con "dotnet list package" con la opcion outdated;
    el proyecto no se compilo en el entorno de redaccion.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Cobranza.Api</RootNamespace>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" Version="6.0.1" />
    <PackageReference Include="Microsoft.ApplicationInsights.AspNetCore" Version="2.22.0" />
    <!-- Fija la dependencia transitiva de Microsoft.Data.SqlClient 6.0.1 (que trae 9.0.0) fuera del
         rango vulnerable 9.0.0-9.0.20: GHSA-846f-f764-76mx (CVE-2026-84008) y GHSA-2fmv-rv2c-59x7
         (CVE-2026-70162). ADR-001: se usa 10.0.13 porque Azure.Extensions.AspNetCore.DataProtection.Blobs
         1.5.5 trae Microsoft.AspNetCore.DataProtection 10.0.13, que exige Pkcs >= 10.0.13 (con 9.0.21
         el proyecto de pruebas falla con NU1605). Revisar al actualizar SqlClient. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
    <!-- ADR-001 5.5: claves de Data Protection en Blob Storage, cifradas con una clave de Key Vault,
         con la identidad administrada del sistema. PasswordHasher (Microsoft.Extensions.Identity.Core)
         ya viene en el framework compartido Microsoft.AspNetCore.App: no se agrega paquete. -->
    <PackageReference Include="Azure.Extensions.AspNetCore.DataProtection.Blobs" Version="1.5.5" />
    <PackageReference Include="Azure.Extensions.AspNetCore.DataProtection.Keys" Version="1.6.5" />
    <PackageReference Include="Azure.Identity" Version="1.21.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Cobranza.Comun\Cobranza.Comun.csproj" />
  </ItemGroup>
</Project>
