<Project Sdk="Microsoft.NET.Sdk.Web">
  <!--
    Proyecto APT Cobranza Automatizada - API interna de consulta (Evidencia S11)
    Azure App Service Linux, runtime DOTNETCORE|10.0.
    Versiones de paquetes a confirmar con "dotnet list package" con la opcion outdated;
    el proyecto no se compilo en el entorno de redaccion.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Cobranza.Api</RootNamespace>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" Version="6.0.1" />
    <PackageReference Include="Microsoft.ApplicationInsights.AspNetCore" Version="2.22.0" />
    <!-- Fija la dependencia transitiva de Microsoft.Data.SqlClient 6.0.1 (que trae 9.0.0)
         en la version parcheada minima: GHSA-846f-f764-76mx (CVE-2026-84008) y
         GHSA-2fmv-rv2c-59x7 (CVE-2026-70162). Retirar al actualizar SqlClient a una
         version que ya dependa de 9.0.21 o superior. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="9.0.21" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Cobranza.Comun\Cobranza.Comun.csproj" />
  </ItemGroup>
</Project>
