<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Proyecto APT Cobranza Automatizada - Herramienta de consola para altas de credenciales (ADR-001 5.9).
    Comandos: hash-clave y nueva-clave-api. La ejecuta SOLO un integrante humano en su propia
    terminal (regla SEG-H01); ningun agente de Claude Code la ejecuta. Interfaz en README.md.
    Usa el framework compartido Microsoft.AspNetCore.App para que PasswordHasher sea exactamente
    el mismo que usa la API (formato V3, opciones por defecto).
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Cobranza.Herramientas</RootNamespace>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Cobranza.Comun\Cobranza.Comun.csproj" />
  </ItemGroup>
</Project>
